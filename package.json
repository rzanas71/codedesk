{
  "name": "codedesk",
  "version": "0.1.0",
  "private": true,
  "description": "School-configured in-browser code playground — editor, preview, console. Zero setup.",
  "author": "CodeDesk",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --win --linux"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "esbuild-wasm": "^0.28.2",
    "monaco-editor": "^0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.105.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.codedesk.app",
    "productName": "CodeDesk",
    "copyright": "Copyright © CodeDesk",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeDesk"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Development",
      "maintainer": "CodeDesk <codedesk@example.com>",
      "synopsis": "In-browser code playground",
      "icon": "public/icon.png"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils"]
    }
  }
}
